# === Cole tudo isto na Vercel: Settings → Environment Variables ===
# Marque Production + Preview. Depois: Redeploy.

# Mercado Pago
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx
MERCADOPAGO_CLIENT_ID=xxxxxxxx
MERCADOPAGO_CLIENT_SECRET=xxxxxxxx

# URL pública do deploy (sem barra no final) — usada em webhooks e preview do link
NEXT_PUBLIC_APP_URL=https://seu-projeto.vercel.app

# Firebase
FIREBASE_PROJECT_ID=gestorfinan-88c9c
FIREBASE_STORAGE_BUCKET=gestorfinan-88c9c.firebasestorage.app
# Opcional, mas recomendado (JSON da service account em UMA linha):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Admin
NEXT_PUBLIC_ADMIN_INVITE=frysushi-admin
NEXT_PUBLIC_ADMIN_EMAIL=admin@frysushi.com
