# Mercado Pago — publique só a Public Key no cliente
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx
MERCADOPAGO_CLIENT_ID=xxxxxxxx
MERCADOPAGO_CLIENT_SECRET=xxxxxxxx

# URL pública do site (webhooks / retorno de pagamento)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional: service account Firebase (JSON em uma linha) para webhook/estorno no servidor
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_PROJECT_ID=obinarias-68350

# Email do primeiro administrador (opcional)
NEXT_PUBLIC_ADMIN_EMAIL=admin@frysuroll.com
