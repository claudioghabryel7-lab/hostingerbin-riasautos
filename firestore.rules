rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /store/{docId} {
      allow read, write: if true;
    }

    match /menuItems/{itemId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /users/{uid} {
      allow read, write: if true;
    }

    match /images/{imageId} {
      allow read, write: if true;
    }

    match /admins/{uid} {
      allow read, write: if true;
    }
  }
}
