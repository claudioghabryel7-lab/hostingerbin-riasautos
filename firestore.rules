rules_version = '2';

// App sem Firebase Auth: tudo no Firestore (contas, pedidos, cardápio, imagens).
// Publique estas regras no Firebase Console para o site funcionar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /store/{docId} {
      allow read, write: if true;
    }

    match /menuItems/{itemId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /users/{uid} {
      allow read, write: if true;
    }

    match /images/{imageId} {
      allow read, write: if true;
    }

    // legado
    match /admins/{uid} {
      allow read, write: if true;
    }
  }
}
